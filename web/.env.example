# Copy to .env — values are baked in at build time (vite), not read on the server at runtime.

# Public API base URL (no trailing slash). Points at the @complianceos/server
# Express API — routes are mounted at the root (e.g. /auth/login), not under
# /api. In local dev this is the server's PORT from the root .env (4000 by
# default): http://localhost:4000
VITE_API_URL=http://localhost:4000

# Google Sign-In (OAuth client ID — not the secret)
VITE_GOOGLE_CLIENT_ID=
