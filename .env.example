# --- Server ---
PORT=4000
NODE_ENV=development

# Free/Pro: Supabase connection string. Enterprise: customer's own Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/compliance_os

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# 32-byte key, hex-encoded (64 hex chars) — used to encrypt org-supplied AI
# keys at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Google OAuth (frontend uses @react-oauth/google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
# redirect_uri used when exchanging the OAuth authorization code at /auth/google
# (must match what the frontend sent to Google); defaults to GOOGLE_CALLBACK_URL.
GOOGLE_REDIRECT_URI=

# --- Outbound mail for OTP emails (optional) ---
# Without SMTP_HOST, OTP codes are printed to the server console (dev only).
# SMTP over implicit TLS (port 465); STARTTLS on 587 is NOT supported.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ComplianceOS <no-reply@complianceos.local>"

# --- Networking ---
# Set when running behind a reverse proxy / load balancer so req.ip is the real
# client IP (used by the IP allowlist and audit log). "1" = one proxy hop.
TRUST_PROXY=

# --- Storage: "supabase" for Free/Pro, "s3" for Enterprise ---
STORAGE_MODE=supabase

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=complianceos

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# --- Jobs ---
REDIS_URL=redis://localhost:6379

# --- AI providers (platform default; orgs may override via OrganizationAIConfig) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Base URL of a local Ollama server when an org selects the OLLAMA provider.
OLLAMA_BASE_URL=http://localhost:11434
# AWS Bedrock — the platform default AI provider when a token or AWS keys are set
# (an org can still bring its own provider/key in Settings > AI).
# Bedrock API key (bearer token); alternatively leave blank and use AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / an instance role / AWS_PROFILE via the default credential chain.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-south-1
AWS_BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0
AWS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Local file storage (STORAGE_MODE=local: dev/demo, no Supabase/S3 needed) ---
STORAGE_LOCAL_DIR=./storage
# Base URL of this API as the browser sees it (used in signed file links)
PUBLIC_API_URL=http://localhost:4000

# --- Multimodal ingestion: second, independent reader for cross-checking ---
# Leave blank to reuse AWS_BEDROCK_MODEL_ID with a differently-worded blind prompt.
# For genuine model independence set another Bedrock model id enabled in your account.
AWS_BEDROCK_VERIFIER_MODEL_ID=

# --- Testing only: deterministic mock model (no cloud calls) ---
# AI_MOCK=1
# AI_MOCK_FIXTURES=/path/to/fixtures.json   # [{ "match": "<regex>", "response": {...} }]
